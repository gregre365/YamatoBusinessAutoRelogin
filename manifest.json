{
    "name": "B2クラウド自動再ログイン",
    "version": "0.2.0",
    "description": "B2クラウド自動再ログイン",
    "manifest_version": 3,
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://newb2web.kuronekoyamato.co.jp/system_error.html*",
                "https://bmypage.kuronekoyamato.co.jp/bmypage/servlet/*",
                "https://bmypage.kuronekoyamato.co.jp/bmypage/logout_systemError.htm*"
            ],
            "js": [
                "contentScript.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "icons": {
        "128": "icon128.png"
    }
}
